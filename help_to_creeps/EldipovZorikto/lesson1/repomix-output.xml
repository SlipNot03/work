import numpy as np
from scipy import stats
import matplotlib.pyplot as plt

# Исходные данные
data = np.array([
    72.0, 72.9, 74.9, 76.5, 75.7, 77.8, 75.0, 73.4, 74.1, 72.8, 76.1, 74.1,
    72.8, 77.4, 78.3, 71.2, 70.3, 70.3, 76.0, 68.9, 76.6, 73.7, 74.7, 77.7,
    76.2, 69.1, 67.6, 70.3, 74.9, 75.4, 75.3, 71.1, 77.3, 73.3, 75.2, 77.5,
    70.7, 77.3, 73.9, 76.3, 75.5, 73.9, 67.8, 72.2, 74.5, 77.4, 73.0, 72.5,
    73.7, 72.3, 76.1, 77.1, 76.8, 78.2, 77.0, 78.3, 72.8, 77.7, 70.1, 69.8,
    71.0, 75.9, 72.0, 70.5, 78.8, 78.4, 73.5, 78.2, 78.4, 74.8, 77.8, 73.1,
    71.0, 76.4, 73.5, 68.5, 70.5, 68.6, 78.2, 72.1, 77.2, 77.4, 79.5, 78.0,
    68.8, 77.7, 73.1, 78.3, 77.0, 68.8, 74.5, 71.6, 73.5, 75.8, 75.0, 73.2,
    76.1, 69.4, 77.5, 78.8
])

# Параметры
n = len(data)
alpha = 0.05
print(f"Объем выборки: n = {n}")
print(f"Уровень значимости: α = {alpha}\n")

# Основные характеристики
x_min, x_max = data.min(), data.max()
x_mean = data.mean()
x_var = data.var(ddof=1)  # несмещенная оценка
x_std = data.std(ddof=1)
print(f"Минимум: {x_min:.1f}")
print(f"Максимум: {x_max:.1f}")
print(f"Среднее: {x_mean:.3f}")
print(f"Дисперсия: {x_var:.3f}")
print(f"СКО: {x_std:.3f}\n")

# Функция для группировки данных
def group_data(data, bins=8):
    """Группировка данных в интервалы"""
    hist, bin_edges = np.histogram(data, bins=bins)
    intervals = list(zip(bin_edges[:-1], bin_edges[1:]))
    return intervals, hist, bin_edges

# Функция для объединения интервалов с малыми теоретическими частотами
def merge_intervals(observed, expected, intervals):
    """Объединение интервалов, где expected < 5"""
    merged_obs = []
    merged_exp = []
    merged_int = []
    
    i = 0
    while i < len(observed):
        obs_sum = observed[i]
        exp_sum = expected[i]
        int_start = intervals[i][0]
        int_end = intervals[i][1]
        
        # Объединяем, пока частота < 5
        while i < len(observed) - 1 and exp_sum < 5:
            i += 1
            obs_sum += observed[i]
            exp_sum += expected[i]
            int_end = intervals[i][1]
        
        merged_obs.append(obs_sum)
        merged_exp.append(exp_sum)
        merged_int.append((int_start, int_end))
        i += 1
    
    return merged_obs, merged_exp, merged_int

# 1. Проверка показательного распределения
print("="*60)
print("1. ПРОВЕРКА ГИПОТЕЗЫ О ПОКАЗАТЕЛЬНОМ РАСПРЕДЕЛЕНИИ")
print("="*60)

# Для показательного распределения сдвигаем данные к 0
data_shifted = data - data.min()
lambda_est = 1 / data_shifted.mean()

# Группируем сдвинутые данные
intervals, observed, bin_edges = group_data(data_shifted, bins=8)

# Теоретические вероятности и частоты
expected_probs = []
expected_freqs = []

for i, (a, b) in enumerate(intervals):
    # Функция распределения показательного закона: F(x) = 1 - exp(-λx)
    prob = np.exp(-lambda_est * a) - np.exp(-lambda_est * b)
    expected_probs.append(prob)
    expected_freqs.append(prob * n)

print(f"Оценка параметра λ = 1/mean = {lambda_est:.6f}")
print(f"Сумма вероятностей: {sum(expected_probs):.4f}")

# Объединяем интервалы с малыми теоретическими частотами
merged_obs, merged_exp, merged_int = merge_intervals(observed, expected_freqs, intervals)

# Вычисляем статистику χ²
chi2_exp = 0
for obs, exp in zip(merged_obs, merged_exp):
    chi2_exp += (obs - exp)**2 / exp

# Степени свободы
k = len(merged_obs)  # число интервалов после объединения
r = 1  # оценили один параметр (λ)
df_exp = k - 1 - r

# Критическое значение
critical_exp = stats.chi2.ppf(1 - alpha, df_exp)

print(f"\nРезультаты:")
print(f"Число интервалов после объединения: {k}")
print(f"Степени свободы: df = {df_exp}")
print(f"Вычисленное значение χ²: {chi2_exp:.3f}")
print(f"Критическое значение χ²({alpha}, {df_exp}): {critical_exp:.3f}")

if chi2_exp > critical_exp:
    print("Вывод: Гипотеза о показательном распределении ОТВЕРГАЕТСЯ")
else:
    print("Вывод: Нет оснований отвергнуть гипотезу о показательном распределении")

# 2. Проверка равномерного распределения
print("\n" + "="*60)
print("2. ПРОВЕРКА ГИПОТЕЗЫ О РАВНОМЕРНОМ РАСПРЕДЕЛЕНИИ")
print("="*60)

# Параметры равномерного распределения
a_unif = data.min()
b_unif = data.max()

# Группируем данные
intervals, observed, bin_edges = group_data(data, bins=8)

# Для равномерного распределения
# Плотность: f(x) = 1/(b-a)
density = 1 / (b_unif - a_unif)
# Ширина интервала (примерно одинаковая для всех интервалов)
h = (b_unif - a_unif) / 8

# Теоретические частоты
expected_freqs_unif = [n * h * density] * 8

print(f"Параметры равномерного распределения: a = {a_unif:.1f}, b = {b_unif:.1f}")
print(f"Плотность: f(x) = 1/({b_unif:.1f}-{a_unif:.1f}) = {density:.6f}")
print(f"Теоретическая частота для каждого интервала: {expected_freqs_unif[0]:.1f}")

# Вычисляем статистику χ²
chi2_unif = 0
for obs, exp in zip(observed, expected_freqs_unif):
    chi2_unif += (obs - exp)**2 / exp

# Степени свободы
k_unif = 8  # не объединяем интервалы, так как все частоты >= 5
r_unif = 2  # оценили два параметра (a и b)
df_unif = k_unif - 1 - r_unif

# Критическое значение
critical_unif = stats.chi2.ppf(1 - alpha, df_unif)

print(f"\nРезультаты:")
print(f"Число интервалов: {k_unif}")
print(f"Степени свободы: df = {df_unif}")
print(f"Вычисленное значение χ²: {chi2_unif:.3f}")
print(f"Критическое значение χ²({alpha}, {df_unif}): {critical_unif:.3f}")

if chi2_unif > critical_unif:
    print("Вывод: Гипотеза о равномерном распределении ОТВЕРГАЕТСЯ")
else:
    print("Вывод: Нет оснований отвергнуть гипотезу о равномерном распределении")

# 3. Проверка нормального распределения
print("\n" + "="*60)
print("3. ПРОВЕРКА ГИПОТЕЗЫ О НОРМАЛЬНОМ РАСПРЕДЕЛЕНИИ")
print("="*60)

# Параметры нормального распределения
mu = data.mean()
sigma = data.std(ddof=1)

# Группируем данные
intervals, observed, bin_edges = group_data(data, bins=8)

# Теоретические вероятности и частоты для нормального распределения
expected_probs_norm = []
expected_freqs_norm = []

for i, (a, b) in enumerate(intervals):
    # Вероятность через функцию распределения
    prob = stats.norm.cdf(b, mu, sigma) - stats.norm.cdf(a, mu, sigma)
    expected_probs_norm.append(prob)
    expected_freqs_norm.append(prob * n)

print(f"Параметры нормального распределения: μ = {mu:.3f}, σ = {sigma:.3f}")
print(f"Сумма вероятностей: {sum(expected_probs_norm):.4f}")

# Объединяем интервалы с малыми теоретическими частотами
merged_obs_norm, merged_exp_norm, merged_int_norm = merge_intervals(
    observed, expected_freqs_norm, intervals
)

# Вычисляем статистику χ²
chi2_norm = 0
for obs, exp in zip(merged_obs_norm, merged_exp_norm):
    chi2_norm += (obs - exp)**2 / exp

# Степени свободы
k_norm = len(merged_obs_norm)
r_norm = 2  # оценили два параметра (μ и σ)
df_norm = k_norm - 1 - r_norm

# Критическое значение
critical_norm = stats.chi2.ppf(1 - alpha, df_norm)

print(f"\nРезультаты:")
print(f"Число интервалов после объединения: {k_norm}")
print(f"Степени свободы: df = {df_norm}")
print(f"Вычисленное значение χ²: {chi2_norm:.3f}")
print(f"Критическое значение χ²({alpha}, {df_norm}): {critical_norm:.3f}")

if chi2_norm > critical_norm:
    print("Вывод: Гипотеза о нормальном распределении ОТВЕРГАЕТСЯ")
else:
    print("Вывод: Нет оснований отвергнуть гипотезу о нормальном распределении")

# Визуализация (опционально)
print("\n" + "="*60)
print("ВИЗУАЛИЗАЦИЯ РАСПРЕДЕЛЕНИЙ")
print("="*60)

fig, axes = plt.subplots(1, 3, figsize=(15, 5))

# Гистограмма и показательное распределение
axes[0].hist(data_shifted, bins=8, density=True, alpha=0.6, color='blue', label='Данные')
x_plot = np.linspace(0, data_shifted.max(), 100)
axes[0].plot(x_plot, stats.expon.pdf(x_plot, scale=1/lambda_est), 'r-', label=f'Exp(λ={lambda_est:.3f})')
axes[0].set_title('Показательное распределение')
axes[0].set_xlabel('x')
axes[0].set_ylabel('Плотность')
axes[0].legend()
axes[0].grid(True, alpha=0.3)

# Гистограмма и равномерное распределение
axes[1].hist(data, bins=8, density=True, alpha=0.6, color='green', label='Данные')
x_plot = np.linspace(data.min(), data.max(), 100)
axes[1].plot(x_plot, stats.uniform.pdf(x_plot, loc=data.min(), scale=data.max()-data.min()), 
            'r-', label=f'U({data.min():.1f},{data.max():.1f})')
axes[1].set_title('Равномерное распределение')
axes[1].set_xlabel('x')
axes[1].set_ylabel('Плотность')
axes[1].legend()
axes[1].grid(True, alpha=0.3)

# Гистограмма и нормальное распределение
axes[2].hist(data, bins=8, density=True, alpha=0.6, color='purple', label='Данные')
x_plot = np.linspace(data.min(), data.max(), 100)
axes[2].plot(x_plot, stats.norm.pdf(x_plot, mu, sigma), 'r-', label=f'N({mu:.1f},{sigma:.1f}²)')
axes[2].set_title('Нормальное распределение')
axes[2].set_xlabel('x')
axes[2].set_ylabel('Плотность')
axes[2].legend()
