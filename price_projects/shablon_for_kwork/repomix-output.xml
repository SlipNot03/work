  .hero__content {
    padding: 62px 16px 44px;
  }

  h1 {
    font-size: 40px;
  }

  .button {
    width: 100%;
  }

  .quiz__step {
    min-height: 320px;
  }

  .footer span {
    display: block;
    margin: 8px 0 0;
  }
}
